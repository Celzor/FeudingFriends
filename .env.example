# Optional Docker settings. The default works without a .env file.
HOST_PORT=3011
# Leave empty for direct access at http://YOUR-SERVER-IP:3011.
# For an HTTPS reverse proxy, set this to its public origin, e.g. https://feud.example.com.
PUBLIC_ORIGIN=
# To embed the game in Refract, use "'self' https://chat.example.com".
REFRACT_FRAME_ANCESTORS="'self'"
# Never put secrets in VITE_* variables.
# Set VITE_SERVER_URL at build time only for a separately hosted standalone frontend.
# VITE_SERVER_URL=https://feud-api.example.com
