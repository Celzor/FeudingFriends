{
  "name": "socketio-server",
  "version": "1.0.0",
  "description": "A simple Socket.IO server",
  "main": "server.ts",
  "scripts": {
    "start": "nodemon --watch ./src/**/* -e ts,tsx --exec ./node_modules/.bin/ts-node ./src/server.ts",
    "start:test": "./node_modules/.bin/ts-node ./src/server.ts",
    "start:prod": "./node_modules/.bin/ts-node ./src/server.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "css-loader": "^7.1.1",
    "csv": "^6.3.8",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "nodemon": "^3.1.0",
    "react-confetti": "^6.1.0",
    "socket.io": "^4.7.5",
    "style-loader": "^4.0.0",
    "use-sound": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/socket.io": "^3.0.2",
    "ts-node": "^10.2.1",
    "typescript": "^5.4.5"
  }
}
