
networks:
  traefik-net:
    external: true

services:
  app:
    networks:
      - traefik-net
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=traefik-net"

      - "traefik.http.services.feuder.loadbalancer.server.port=3010"

      - "traefik.http.routers.feuder.rule=Host(`feuder.tgxn.local`)"
      - "traefik.http.routers.feuder.entrypoints=http"

      - "traefik.http.routers.feuder_https.rule=Host(`feuder.tgxn.local`)"
      - "traefik.http.routers.feuder_https.entrypoints=https"
      - "traefik.http.routers.feuder_https.tls.certResolver=tgxn_local"

      - "traefik.http.routers.feuder_http_redirect.rule=Host(`feuder.tgxn.local`)"
      - "traefik.http.routers.feuder_http_redirect.entrypoints=http"
      - "traefik.http.routers.feuder_http_redirect.middlewares=redirect_https@file"
  
